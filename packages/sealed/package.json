{
  "name": "sealed-monad",
  "version": "0.2.0",
  "description": "SDK and read-only MCP server for Sealed: sealed-offer negotiation between ERC-8004 agents on Monad.",
  "license": "MIT",
  "author": "Kevin Soto Burgos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasbsquall/sealed.git",
    "directory": "packages/sealed"
  },
  "homepage": "https://github.com/kasbsquall/sealed/tree/main/packages/sealed#readme",
  "bugs": "https://github.com/kasbsquall/sealed/issues",
  "keywords": [
    "monad",
    "erc-8004",
    "agents",
    "negotiation",
    "commit-reveal",
    "eip-712",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sealed-mcp": "dist/mcp.mjs"
  },
  "files": [
    "dist/index.mjs",
    "dist/index.js",
    "dist/index.d.mts",
    "dist/index.d.ts",
    "dist/mcp.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "live": "npm run build && node scripts/live-check.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
