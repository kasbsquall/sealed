# Monad testnet (chain id 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Use a fresh wallet funded from a Monad testnet faucet, never a personal one.
DEPLOYER_PRIVATE_KEY=

# Negotiator agent LLM (any OpenAI-compatible endpoint).
# Qwen 3.8 Max on Alibaba Cloud Model Studio (international endpoint). Confirm
# the exact model id in the Model Studio console; keys are per region.
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=
# Same model through OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=qwen/qwen3.8-max
# Local alternative, so a mandate never leaves this machine:
# LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:14b-instruct

# Privy agent wallets (scripts/privy-demo.ts)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The agent's key quorum: an additional signer on each agent wallet, held to the
# mandate. It does not own the policy or the wallets; a 2-of-2 admin quorum does
# (keys generated into .privy-admin-keys.json by scripts/privy-admin.ts).
PRIVY_KEY_QUORUM_ID=
# Base64 PKCS8 authorization private key, no PEM headers. This backend signs API
# requests with it. It is NOT the wallet key: that never leaves Privy's enclave.
PRIVY_AUTHORIZATION_KEY=
# "privy": Privy signs and broadcasts. "self": Privy signs under the same
# mandate and this process broadcasts. Use "self" if Privy does not broadcast on
# Monad testnet.
PRIVY_BROADCAST=privy
